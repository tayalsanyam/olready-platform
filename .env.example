# Postgres connection. On Supabase use the pooler URI (transaction mode, port 6543).
DATABASE_URL=postgres://postgres:password@db.example.supabase.co:6543/postgres

# Supabase Auth (email one-time codes). Mumbai region project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key for photo uploads to Supabase Storage (bucket created by migration 4). Never expose it.
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=olready-media

# Public site URL, used in sitemaps, canonical links and emails
NEXT_PUBLIC_SITE_URL=https://olready.in

# Email via Resend (optional locally; emails stay in mkt.email_outbox without it)
RESEND_API_KEY=
EMAIL_FROM=OLReady <care@olready.in>

# Payments. Each gateway is also switched on/off by staff in Ops > Payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYU_KEY=
PAYU_SALT=
PAYU_BASE_URL=https://secure.payu.in

# Seller details printed on transaction invoices
SELLER_NAME=Katalyst Infomedia
SELLER_ADDRESS=Chandigarh
SELLER_GSTIN=
# State used when SELLER_GSTIN is empty; the GSTIN's first two digits win otherwise.
SELLER_STATE=Chandigarh
SELLER_EMAIL=hello@olready.in
# Tax invoices: number prefix (OLR/26-27/00001, credit notes OLR-CN/...) and SAC codes.
INVOICE_PREFIX=OLR
INVOICE_SAC=998365
INVOICE_SAC_SERVICES=998599

# Protects /api/cron/* (set the same value in Vercel Cron)
CRON_SECRET=

# Local development only: lets you sign in as seeded demo users at /dev-login.
# Never set in production.
DEV_AUTH=

# Sales site (mua.olready.in) link-up
# Read-only connection to the sales site's database: lets an admin sync staff in Ops → Staff.
SALES_DATABASE_URL=
# Shown as "Open sales-site admin" in Ops → Staff.
SALES_ADMIN_URL=https://mua.olready.in/admin

# Resend delivery webhook (Resend > Webhooks > endpoint https://<site>/api/resend, events
# email.bounced, email.complained, email.delivery_delayed). Its signing secret, starting whsec_.
RESEND_WEBHOOK_SECRET=
# Signs unsubscribe links (any long random string; falls back to CRON_SECRET).
UNSUBSCRIBE_SECRET=

# Search by photo and the AI tools. Without it, brides pick styles by hand.
ANTHROPIC_API_KEY=
# Optional model overrides.
ANTHROPIC_VISION_MODEL=claude-haiku-5-5

# Signs the staff authenticator session (any long random string; falls back to CRON_SECRET).
# Turn on 'Staff must use an authenticator app' in Ops > Settings once the team has set it up.
MFA_SECRET=

# AI: Ops data assistant and quote reader (both use ANTHROPIC_API_KEY)
ANTHROPIC_OPS_MODEL=claude-sonnet-5-5
ANTHROPIC_QUOTE_MODEL=claude-haiku-5-5
# Ask OLReady (brides' planning helper)
ANTHROPIC_BRIDE_MODEL=claude-sonnet-5-5
# Only for local testing against a stand-in API
ANTHROPIC_BASE_URL=

# WhatsApp (off until set): WHATSAPP_PROVIDER=meta or wati
WHATSAPP_PROVIDER=
WHATSAPP_TOKEN=
# Meta Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# Wati
WATI_API_URL=
# Webhook: Meta verify token, or ?token= on the Wati webhook URL (/api/whatsapp)
WHATSAPP_VERIFY_TOKEN=
