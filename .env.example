# Postgres connection. On Supabase use the pooler URI (transaction mode, port 6543).
DATABASE_URL=postgres://postgres:password@db.example.supabase.co:6543/postgres

# Supabase Auth (email one-time codes). Mumbai region project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key for photo uploads to Supabase Storage (bucket created by migration 4). Never expose it.
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=olready-media

# Public site URL, used in sitemaps, canonical links and emails
NEXT_PUBLIC_SITE_URL=https://olready.in

# Email via Resend (optional locally; emails stay in mkt.email_outbox without it)
RESEND_API_KEY=
EMAIL_FROM=OLReady <care@olready.in>

# Payments. Each gateway is also switched on/off by staff in Ops > Payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYU_KEY=
PAYU_SALT=
PAYU_BASE_URL=https://secure.payu.in

# Seller details printed on transaction invoices
SELLER_NAME=Katalyst Infomedia
SELLER_ADDRESS=Chandigarh
SELLER_GSTIN=

# Protects /api/cron/* (set the same value in Vercel Cron)
CRON_SECRET=

# Local development only: lets you sign in as seeded demo users at /dev-login.
# Never set in production.
DEV_AUTH=

# Sales site (mua.olready.in) link-up
# Read-only connection to the sales site's database: lets an admin sync staff in Ops → Staff.
SALES_DATABASE_URL=
# Shown as "Open sales-site admin" in Ops → Staff.
SALES_ADMIN_URL=https://mua.olready.in/admin
